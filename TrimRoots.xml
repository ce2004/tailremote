<!--
  Kept whole by the trimmer (release builds only). The Windows clipboard calls back into
  TailRemote through .NET's COM data-exchange types: trimmed away, putting anything on the
  clipboard hung or crashed (2.0.0 to 2.1.3). The clipboard test in the self-test guards it.
-->
<linker>
  <assembly fullname="System.Private.CoreLib">
    <namespace fullname="System.Runtime.InteropServices.ComTypes" preserve="all" />
    <namespace fullname="System.Runtime.InteropServices" preserve="all" />
  </assembly>
  <assembly fullname="System.Runtime.InteropServices" preserve="all" />
</linker>
